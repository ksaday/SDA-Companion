# ---------------------------------------------------------------------------
# Grace Companion — environment
# Copy to .env.local. Every value below is a PLACEHOLDER.
# The app runs fully offline with none of them set (see OFFLINE MODE below).
# ---------------------------------------------------------------------------

# Local dev database (SQLite). Production: postgresql://user:pass@host:5432/grace
DATABASE_URL="file:./prisma/dev.db"

# --- AI layer ---------------------------------------------------------------
# OFFLINE MODE: leave GOOGLE_AI_API_KEY empty and the app uses the built-in
# template composer, which assembles prayers only from retrieved corpus text.
# Set a key to route generation through Gemini (still corpus-grounded).
GOOGLE_AI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Retrieval confidence gates (see planning doc §13.7)
CONFIDENCE_INCLUDE_THRESHOLD="0.30"
CONFIDENCE_FLOOR="0.18"

# --- NotebookLM corpus sync (Phase 1) ---------------------------------------
# NotebookLM has no public query API; the sync job reads the same Google Drive
# folder the NotebookLM workspace imports from. Fill in when the workspace lands.
NOTEBOOKLM_NOTEBOOK_ID=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""

# --- Firebase Auth (Phase 0) ------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# --- Stripe (Phase 4) -------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_ANNUAL=""

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FREE_TIER_DAILY_SESSIONS="3"
